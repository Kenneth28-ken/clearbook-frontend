rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Business users can manage their own data
    match /users/{userId} {
      // Allow the owner full access
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Public subcollections for the digital menu
      match /config/terminal {
        allow read: if true; 
      }

      match /products/{productId} {
        allow read: if true;
      }

      match /mobile_orders/{orderId} {
        // Owner can manage orders
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // Customers can place orders
        allow create: if true;
        // Customers can read their own order status if they have the ID (optional, but keep it simple)
        allow get: if true;
      }
      
      // Other collections remains restricted to owner
      match /staff/{staffId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /attendants/{attendantId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /history/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /customers/{phone} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // POS accounts registry for status/business info
    match /pos_accounts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow public read of business info for the menu
      allow get: if true;
    }
  }
}
