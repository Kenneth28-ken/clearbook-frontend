rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for Master Admin access
    function isMaster() {
      return request.auth != null && request.auth.token.email == 'perfectmaney200@gmail.com';
    }

    // 1. Business Data (Products, History, Staff, etc.)
    match /users/{userId} {
      // Owner or Master Admin full access
      allow read, write: if isMaster() || (request.auth != null && request.auth.uid == userId);
      
      match /{allPaths=**} {
        allow read, write: if isMaster() || (request.auth != null && request.auth.uid == userId);
      }

      // PUBLIC ACCESS: Required for Digital Menu (QR Code)
      match /config/terminal {
        allow read: if true;
      }
      match /products/{productId} {
        allow read: if true;
      }
      match /mobile_orders/{orderId} {
        // Customers can place orders and check status
        allow create, get: if true;
      }
    }

    // 2. Master Registry / POS Accounts
    match /pos_accounts/{accountId} {
      allow read, write: if isMaster() || (request.auth != null && request.auth.uid == accountId);
      
      // Public get for business details in the digital menu
      allow get: if true;

      match /{allPaths=**} {
        allow read, write: if isMaster() || (request.auth != null && request.auth.uid == accountId);
      }
    }

    // LISTING: Allow Master to see the registry
    match /pos_accounts {
      allow list: if isMaster();
    }
    match /users {
      allow list: if isMaster();
    }
  }
}
